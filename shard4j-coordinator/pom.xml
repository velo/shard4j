<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.marvinformatics</groupId>
    <artifactId>shard4j</artifactId>
    <version>0.6.0</version>
  </parent>

  <artifactId>shard4j-coordinator</artifactId>

  <name>shard4j-coordinator</name>
  <description>The single-instance scheduling service: HTTP, leases, storage, verdict.</description>

  <properties>
    <!-- The coordinator is a deployed service, not a library on someone else's
         classpath, so it is free to sit on the current LTS. -->
    <maven.compiler.release>${coordinator.compiler.release}</maven.compiler.release>
    <rewrite.java.recipe>${coordinator.rewrite.java.recipe}</rewrite.java.recipe>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.marvinformatics</groupId>
      <artifactId>shard4j-protocol</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Compile-time only: constructors, builders and loggers. Provided scope keeps
         it out of the shipped tree. -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- The testing cornerstone here is the real repackaged jar running in a real
         container over real HTTP; Testcontainers builds that image from the jar as
         part of the failsafe run. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- The integration tests talk to the container over the same Feign + Jackson stack
         the shipped engine uses, so a client-stack bug fails here first. Test scope only:
         the coordinator's own runtime stays Spring. -->
    <dependency>
      <groupId>io.github.openfeign</groupId>
      <artifactId>feign-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.openfeign</groupId>
      <artifactId>feign-jackson</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- JDK 23+ no longer runs classpath annotation processors implicitly, so
           Lombok must be named here to run at all. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>com.marvinformatics.shard4j.coordinator</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>repackage</id>
            <goals>
              <goal>repackage</goal>
            </goals>
            <configuration>
              <!-- Keep the plain jar as the published artifact; the runnable app
                   is a classified sidecar. -->
              <classifier>app</classifier>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <systemPropertyVariables>
            <coordinator.app.jar>${project.build.directory}/${project.build.finalName}-app.jar</coordinator.app.jar>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <!-- The other direction of the one-directional graph in section 11.1:
               the coordinator talks to shards over HTTP, never by linking the
               engine. -->
          <execution>
            <id>enforce-coordinator-never-reaches-engine</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>com.marvinformatics:shard4j-engine</exclude>
                  </excludes>
                  <message>MODULE BOUNDARY VIOLATION: the module graph is one-directional. shard4j-coordinator and shard4j-engine share shard4j-protocol and nothing else.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- The Spring recipes only make sense here: the coordinator is the one module
         that has ever heard of Spring, and the enforcer rules exist to keep it that
         way. Adds a third execution to the plugin the parent's `openrewrite` profile
         already declares. -->
    <profile>
      <id>openrewrite</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openrewrite.maven</groupId>
            <artifactId>rewrite-maven-plugin</artifactId>
            <dependencies>
              <dependency>
                <groupId>org.openrewrite.recipe</groupId>
                <artifactId>rewrite-spring</artifactId>
                <version>${rewrite-spring.version}</version>
              </dependency>
            </dependencies>
            <executions>
              <execution>
                <id>spring</id>
                <goals>
                  <goal>runNoFork</goal>
                </goals>
                <phase>verify</phase>
                <configuration>
                  <exportDatatables>true</exportDatatables>
                  <activeRecipes>
                    <!-- The version bump inside UpgradeSpringBoot_4_0 is inert with
                         pom.xml excluded, which is what we want: this build is already
                         on 4.1.x, so only the code and property migrations apply. -->
                    <recipe>org.openrewrite.java.spring.boot4.UpgradeSpringBoot_4_0</recipe>
                    <recipe>org.openrewrite.java.spring.boot4.SpringBootProperties_4_1</recipe>
                    <recipe>org.openrewrite.java.spring.NoAutowiredOnConstructor</recipe>
                    <recipe>org.openrewrite.java.spring.NoRequestMappingAnnotation</recipe>
                    <recipe>org.openrewrite.java.spring.framework.BeanMethodsNotPublic</recipe>
                    <recipe>org.openrewrite.java.spring.boot3.PreciseBeanType</recipe>
                  </activeRecipes>
                  <exclusions>
                    <exclusion>pom.xml</exclusion>
                  </exclusions>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- This module is published to Maven Central. The parent's `release` profile
         holds the plugin's version and configuration but does not inherit the
         declaration: the publish goal must exist only in the models of published
         modules, because it fails on artifact-less modules (shard4j-example) and
         the bundle upload runs at the last reactor module that declares it. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>

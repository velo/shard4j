<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.marvinformatics</groupId>
    <artifactId>shard4j</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>shard4j-coordinator</artifactId>

  <name>shard4j-coordinator</name>
  <description>The single-instance scheduling service: HTTP, leases, storage, verdict.</description>

  <properties>
    <!-- The coordinator is a deployed service, not a library on someone else's
         classpath, so it is free to sit on the current LTS. -->
    <maven.compiler.release>${coordinator.compiler.release}</maven.compiler.release>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.marvinformatics</groupId>
      <artifactId>shard4j-protocol</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>com.marvinformatics.shard4j.coordinator</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>repackage</id>
            <goals>
              <goal>repackage</goal>
            </goals>
            <configuration>
              <!-- Keep the plain jar as the published artifact; the runnable app
                   is a classified sidecar. -->
              <classifier>app</classifier>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <!-- The other direction of the one-directional graph in section 11.1:
               the coordinator talks to shards over HTTP, never by linking the
               engine. -->
          <execution>
            <id>enforce-coordinator-never-reaches-engine</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>com.marvinformatics:shard4j-engine</exclude>
                  </excludes>
                  <message>MODULE BOUNDARY VIOLATION: the module graph is one-directional. shard4j-coordinator and shard4j-engine share shard4j-protocol and nothing else.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

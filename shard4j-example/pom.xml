<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.marvinformatics</groupId>
    <artifactId>shard4j</artifactId>
    <version>0.3.0-SNAPSHOT</version>
  </parent>

  <artifactId>shard4j-example</artifactId>

  <name>shard4j-example</name>
  <description>A project that has never heard of shard4j's authors. The boundary acceptance test. Not published.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
    <!-- Not published: nothing here to attach or sign for a release. -->
    <maven.source.skip>true</maven.source.skip>
    <maven.javadoc.skip>true</maven.javadoc.skip>
    <gpg.skip>true</gpg.skip>
    <testcontainers.version>1.21.4</testcontainers.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- The whole point of this module: whatever a consumer gets, it gets here first. -->
    <dependency>
      <groupId>com.marvinformatics</groupId>
      <artifactId>shard4j-engine</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- The acceptance harness drives the launcher directly and runs the real
         coordinator jar in a container; all strictly test scope. -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <!-- This module is all test code; there is no main artifact to build. -->
          <skipIfEmpty>true</skipIfEmpty>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <!-- No <includes> block, ever. It replaces failsafe's defaults, and a
               plausible one-line addition here silently drops the whole
               default-matching suite and goes green having run nothing. Tag exclusion
               is the safe filter: the sharding fixtures run only through the harness,
               and a coordinated census inherits this exclusion rather than deadlocking
               on units it would never be handed. -->
          <rerunFailingTestsCount>0</rerunFailingTestsCount>
          <excludedGroups>shard4j-fixture</excludedGroups>
          <environmentVariables>
            <SHARD_COORDINATOR_SECRET>local-integration-only</SHARD_COORDINATOR_SECRET>
          </environmentVariables>
          <systemPropertyVariables>
            <coordinator.app.jar>${project.basedir}/../shard4j-coordinator/target/shard4j-coordinator-${project.version}-app.jar</coordinator.app.jar>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <!-- The boundary, measured where it actually matters: on the test classpath
               of a project that only ever asked for shard4j-engine. -->
          <execution>
            <id>enforce-consumer-classpath-stays-clean</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>com.marvinformatics:shard4j-coordinator</exclude>
                    <exclude>org.springframework:*</exclude>
                    <exclude>org.springframework.boot:*</exclude>
                    <exclude>org.springframework.*:*</exclude>
                  </excludes>
                  <message>A consumer that asked only for shard4j-engine has just been handed the coordinator or a server framework. That is the module boundary failing in the one place it is observable from outside.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- The consumer integration this module exists to demonstrate: junit-jupiter is
         excluded so the shard4j engine owns execution, three integration-test executions
         are the three passes, and one verify aggregates all three summaries. Run it as

           SHARD_COORDINATOR_SECRET=... mvn -Pcoordinated verify \
             -Dshard.coordinator.url=... -Dshard.session.id=$(uuidgen) -Dshard.index=0

         forkCount is deliberately not set anywhere: failsafe's own default of one JVM per
         shard applies, and the shard count is the only parallelism. -->
    <profile>
      <id>coordinated</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <excludeJUnit5Engines>junit-jupiter</excludeJUnit5Engines>
              <rerunFailingTestsCount>0</rerunFailingTestsCount>
              <!-- Non-zero would stop a shard early with leases unhonoured. -->
              <skipAfterFailureCount>0</skipAfterFailureCount>
              <!-- The census inherits this filter, so what a shard is never handed is
                   never registered either. The harness tests drive their own launcher
                   sessions and stay out of a coordinated run. -->
              <excludedGroups>shard4j-fixture,shard4j-harness</excludedGroups>
            </configuration>
            <executions>
              <!-- The default single execution belongs to the uncoordinated build. -->
              <execution>
                <id>default</id>
                <phase>none</phase>
              </execution>
            <execution>
              <id>shard-pass-main</id>
              <goals>
                <goal>integration-test</goal>
              </goals>
              <configuration>
                <!-- A distinct summary file AND a distinct reports directory per pass:
                     the defaults are shared, so pass 3 would overwrite passes 1-2 and a
                     real failure would read as "0 tests, exit 0" in the summary. -->
                <summaryFile>${project.build.directory}/failsafe-reports/main/failsafe-summary.xml</summaryFile>
                <reportsDirectory>${project.build.directory}/failsafe-reports/main</reportsDirectory>
                <systemPropertyVariables>
                  <shard.enabled>true</shard.enabled>
                  <shard.pass>main</shard.pass>
                  <shard.coordinator.url>${shard.coordinator.url}</shard.coordinator.url>
                  <shard.session.id>${shard.session.id}</shard.session.id>
                  <shard.index>${shard.index}</shard.index>
                </systemPropertyVariables>
              </configuration>
            </execution>
            <execution>
              <id>shard-pass-retry1</id>
              <goals>
                <goal>integration-test</goal>
              </goals>
              <configuration>
                <!-- A distinct summary file AND a distinct reports directory per pass:
                     the defaults are shared, so pass 3 would overwrite passes 1-2 and a
                     real failure would read as "0 tests, exit 0" in the summary. -->
                <summaryFile>${project.build.directory}/failsafe-reports/retry1/failsafe-summary.xml</summaryFile>
                <reportsDirectory>${project.build.directory}/failsafe-reports/retry1</reportsDirectory>
                <systemPropertyVariables>
                  <shard.enabled>true</shard.enabled>
                  <shard.pass>retry1</shard.pass>
                  <shard.coordinator.url>${shard.coordinator.url}</shard.coordinator.url>
                  <shard.session.id>${shard.session.id}</shard.session.id>
                  <shard.index>${shard.index}</shard.index>
                </systemPropertyVariables>
              </configuration>
            </execution>
            <execution>
              <id>shard-pass-retry2</id>
              <goals>
                <goal>integration-test</goal>
              </goals>
              <configuration>
                <!-- A distinct summary file AND a distinct reports directory per pass:
                     the defaults are shared, so pass 3 would overwrite passes 1-2 and a
                     real failure would read as "0 tests, exit 0" in the summary. -->
                <summaryFile>${project.build.directory}/failsafe-reports/retry2/failsafe-summary.xml</summaryFile>
                <reportsDirectory>${project.build.directory}/failsafe-reports/retry2</reportsDirectory>
                <systemPropertyVariables>
                  <shard.enabled>true</shard.enabled>
                  <shard.pass>retry2</shard.pass>
                  <shard.coordinator.url>${shard.coordinator.url}</shard.coordinator.url>
                  <shard.session.id>${shard.session.id}</shard.session.id>
                  <shard.index>${shard.index}</shard.index>
                </systemPropertyVariables>
              </configuration>
            </execution>
            <!-- One verify per pass, not one verify listing all three: an execution
                 that ran zero tests writes no summary file at all, and verify hard-fails
                 on a listed-but-missing extra summary. With early release an empty retry
                 pass is the normal green path, so each pass is verified on its own and a
                 missing summary simply means that pass had nothing to do. -->
            <execution>
                <id>shard-verify-main</id>
                <goals>
                  <goal>verify</goal>
                </goals>
                <configuration>
                  <summaryFile>${project.build.directory}/failsafe-reports/main/failsafe-summary.xml</summaryFile>
                </configuration>
              </execution>
            <execution>
                <id>shard-verify-retry1</id>
                <goals>
                  <goal>verify</goal>
                </goals>
                <configuration>
                  <summaryFile>${project.build.directory}/failsafe-reports/retry1/failsafe-summary.xml</summaryFile>
                </configuration>
              </execution>
            <execution>
                <id>shard-verify-retry2</id>
                <goals>
                  <goal>verify</goal>
                </goals>
                <configuration>
                  <summaryFile>${project.build.directory}/failsafe-reports/retry2/failsafe-summary.xml</summaryFile>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
